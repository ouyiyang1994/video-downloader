{
  "manifest_version": 3,
  "name": "Video Downloader 登录助手",
  "version": "1.0.0",
  "description": "把你在 Chrome 中的哔哩哔哩 / Instagram 登录会话交给本机的 Video Downloader。数据只在本机进程之间传递，不会上传。",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "activeTab"],
  "host_permissions": [
    "https://bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Downloader 登录助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
