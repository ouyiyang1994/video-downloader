# ============================================================================
#  Video Downloader — environment template
# ----------------------------------------------------------------------------
#  Copy to `.env` and fill in what you need:
#      cp .env.example .env          # Linux / macOS / Git Bash
#      Copy-Item .env.example .env   # Windows PowerShell
#
#  EVERY value is optional. Platforms without credentials automatically fall
#  back to their public-web path, so the tool works out of the box.
#
#  This file contains placeholders only — never put a real key here.
# ============================================================================

# --- YouTube (official Data API v3, metadata only) --------------------------
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Instagram (Graph API — your own Business/Creator media only) -----------
# https://developers.facebook.com/apps
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Bilibili (optional login cookie; unlocks 1080p for a free account) -----
# Paste the value of the SESSDATA cookie from a logged-in browser session.
BILIBILI_SESSDATA=
# Or a full cookie header string, e.g. "SESSDATA=xxx; bili_jct=yyy"
BILIBILI_COOKIE=
# Netscape cookies.txt exported from a logged-in Bilibili session, resolved
# against the data root. Independent of YTDLP_COOKIEFILE (which is Instagram's).
# A missing file means an anonymous request — never an error.
BILIBILI_COOKIEFILE=www.bilibili.com_cookies.txt

# --- Instagram login state (yt-dlp, optional) -------------------------------
# Only Instagram reads these; YouTube and Bilibili never do.
# Preferred: a Netscape-format cookies.txt exported from the logged-in browser.
# Relative paths resolve against the project root; `secrets/` is gitignored.
YTDLP_COOKIEFILE=
# Fallback when no cookies file is available: read a browser profile directly
# (chrome / edge / firefox / brave ...). Chromium 127+ encrypts cookies with
# App-Bound Encryption, which yt-dlp cannot decrypt, so Firefox is the browser
# that actually works. The browser must be closed while reading.
# Empty = disabled.
YTDLP_COOKIES_FROM_BROWSER=

# --- GUI sign-in (optional) -------------------------------------------------
# The 账号登录 panel in the GUI writes what it obtains to
# <SESSION_DIR>/<platform>_cookies.txt, one file per platform. Those files take
# precedence over the *_COOKIEFILE paths above, and the explicit
# BILIBILI_COOKIE / BILIBILI_SESSDATA values still take precedence over them.
# "退出登录" deletes only these files; your browser is never touched.
SESSION_DIR=secrets

# --- Storage ----------------------------------------------------------------
# Where finished files go, and where the SQLite history lives.
OUTPUT_DIR=downloads
DATABASE_PATH=downloads/downloads.db
LOG_DIR=logs
# Output folder layout. Supported placeholders:
#   {platform} {author} {date} {year} {month} {day}
DIR_TEMPLATE={platform}/{author}/{date}
# Longest allowed filename stem before extension (long titles are truncated).
MAX_FILENAME_LENGTH=120
# Skip a video when the database already has a completed record for it.
SKIP_EXISTING=true

# --- ffmpeg -----------------------------------------------------------------
# Leave empty to auto-discover tools/ffmpeg/bin/ffmpeg(.exe) or anything on PATH.
FFMPEG_PATH=

# --- Proxy ------------------------------------------------------------------
# Local proxy, e.g. a Shadowsocks mixed inbound: http://127.0.0.1:8090
# Leave empty for a direct connection.
HTTP_PROXY=
HTTPS_PROXY=
# Platform ids (comma separated) that must NOT use the proxy.
# Bilibili answers HTTP 412 (risk control) to proxy/datacenter exit IPs, so it
# stays on the direct connection. Set empty to proxy everything.
PROXY_BYPASS_PLATFORMS=bilibili

# --- Networking -------------------------------------------------------------
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CONCURRENT_FRAGMENTS=4
# Download chunk size in bytes (default 1 MiB).
CHUNK_SIZE=1048576
# Override the HTTP User-Agent if a platform requires it. Empty = built-in default.
USER_AGENT=

# --- Behaviour --------------------------------------------------------------
LOG_LEVEL=INFO
# Must be true for platforms whose media is fetched through non-official
# endpoints. Confirms you are downloading content you are allowed to access.
CONFIRM_RIGHTS=false
